# Ollama model server for the `bahs` project — this is the `ollama` service.
#
#   Railway -> this service -> Settings -> Source   -> must be the GitHub repo, NOT a Docker Image
#   Railway -> this service -> Settings -> Build    -> Dockerfile Path = Dockerfile.ollama
#   Railway -> this service -> Settings -> Volumes  -> one volume at /root/.ollama
#
# The `bahs` API service reaches it over private networking at
# http://ollama.railway.internal:11434, so this service needs no public domain.
FROM ollama/ollama:latest

ENV OLLAMA_HOST=0.0.0.0:11434 \
    OLLAMA_MODELS=/root/.ollama \
    MODEL=qwen2.5-coder:3b

EXPOSE 11434

COPY entrypoint-ollama.sh /usr/local/bin/entrypoint-ollama.sh

# The base image ships ENTRYPOINT ["/bin/ollama"]; clear it before setting our own CMD.
ENTRYPOINT []
CMD ["sh", "/usr/local/bin/entrypoint-ollama.sh"]
