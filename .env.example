# Set values privately in Railway Variables. Never put seeds/private keys here.
APP_ENV=production
APP_ORIGIN=https://your-domain.example
DATABASE_URL=postgresql://user:password@database:5432/bahs?sslmode=require
AUTH_SECRET=
ADMIN_USERS=
# Uvicorn is started with --no-proxy-headers. Only trust platform-confirmed
# ingress CIDRs; do not use 0.0.0.0/0. An empty value ignores forwarded headers.
TRUSTED_PROXY_CIDRS=
AUTH_ALLOWED_ORIGINS=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Paid-processor alternative only: NOT a free unlimited blockchain RPC setup.
# Keep disabled until the operator accepts fees/terms and verifies settlement.
NOWPAYMENTS_ENABLED=0
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# PostgreSQL is required in production; local-only SQLite fallback:
ACCOUNT_DB_PATH=data/accounts.sqlite3
