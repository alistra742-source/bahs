# Set values privately in Railway Variables. Never put seeds/private keys here.
APP_ENV=production
APP_ORIGIN=https://your-domain.example
DATABASE_URL=postgresql://user:password@database:5432/bahs?sslmode=require
AUTH_SECRET=
ADMIN_USERS=
# Uvicorn is started with --no-proxy-headers. Only trust platform-confirmed
# ingress CIDRs; do not use 0.0.0.0/0. An empty value ignores forwarded headers.
TRUSTED_PROXY_CIDRS=
AUTH_ALLOWED_ORIGINS=
# Paid-processor alternative only: NOT a free unlimited blockchain RPC setup.
# Keep disabled until the operator accepts fees/terms and verifies settlement.
NOWPAYMENTS_ENABLED=0
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Payout wallet per coin. Each holds EITHER a deposit address (used verbatim)
# OR a recovery phrase, from which the first standard account is derived:
#   BTC 84'/0'/0'/0/0   LTC 84'/2'/0'/0/0   ETH+USDC 44'/60'/0'/0/0
#   SOL+USDT 44'/501'/0'/0'
# Only a public address ever leaves the process; a phrase is never logged or
# returned. A coin with no variable cannot be paid to and its checkout says so
# by name. Verify the derived address against your wallet once before taking
# money on it:
#   python -c "import wallets; print(wallets.address('BTC'))"
SOL=
LTC=
BTC=
ETH=
USDT=
USDC=
# PostgreSQL is required in production; local-only SQLite fallback:
ACCOUNT_DB_PATH=data/accounts.sqlite3
