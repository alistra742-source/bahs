# Set values privately in Railway Variables. Never put seeds/private keys here.
APP_ENV=production
APP_ORIGIN=https://your-domain.example
DATABASE_URL=postgresql://user:password@database:5432/bahs?sslmode=require
AUTH_SECRET=
ADMIN_USERS=
# Optional: rotate the access code that grants the administrator flag, without a
# deploy. Blank uses the code compiled into the server. The code is compared in
# constant time, is never sent to a browser, and is never written to a log.
ADMIN_PROMO_CODE=
# Uvicorn is started with --no-proxy-headers. Only trust platform-confirmed
# ingress CIDRs; do not use 0.0.0.0/0. An empty value ignores forwarded headers.
TRUSTED_PROXY_CIDRS=
AUTH_ALLOWED_ORIGINS=
# Paid-processor alternative only: NOT a free unlimited blockchain RPC setup.
# Keep disabled until the operator accepts fees/terms and verifies settlement.
NOWPAYMENTS_ENABLED=0
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Payout wallet per coin. Each holds EITHER a deposit address (used verbatim)
# OR a recovery phrase, from which the first standard account is derived:
#   BTC 84'/0'/0'/0/0   LTC 84'/2'/0'/0/0   ETH+USDC 44'/60'/0'/0/0
#   SOL+USDT 44'/501'/0'/0'
# Only a public address ever leaves the process; a phrase is never logged or
# returned. A coin with no variable cannot be paid to and its checkout says so
# by name. Verify the derived address against your wallet once before taking
# money on it:
#   python -c "import wallets; print(wallets.address('BTC'))"
SOL=
LTC=
BTC=
ETH=
USDT=
USDC=
# Testing the proxy list (POST /proxies/check) -- optional, all have defaults.
# The URL a proxy is asked for: it must answer 2xx, and should name the exit IP
# so a check also shows which address the site would see. Use an http:// URL if
# the list is CONNECT-only on port 80.
PROXY_CHECK_URL=
# Probes in flight at once, the ceiling for one probe, and the most entries one
# check may sweep. A list bigger than the cap is checked from the top and the
# response says how many were left out.
PROXY_CHECK_CONCURRENCY=
PROXY_CHECK_TIMEOUT=
PROXY_CHECK_MAX=
# Tor, the pool used when no proxy list is stored -- optional, all have defaults.
# A port is not a Tor: an exit is called Tor only after Tor's own checker says
# IsTor for a request made through it. The instance this service starts binds
# 127.0.0.1 on every SocksPort, opens NO control port and relays nothing, so it
# is a private outbound client and never a proxy for anyone else. Check your
# hosting provider's terms before leaving the automatic start on.
TOR_ENABLED=1
# Where a Tor SOCKS listener may already be running (9050 tor, 9150 Tor Browser),
# and where this service's own instance listens. Several ports on purpose: Tor
# keeps the streams of different SocksPorts on different circuits.
TOR_PORTS=9050,9150
TOR_MANAGED_PORTS=9050,9052,9054,9056
TOR_HOST=127.0.0.1
# Start our own tor when nothing is listening, and where it keeps its files.
TOR_AUTO_START=1
TOR_BINARY=tor
TOR_DATA_DIR=data/tor
TOR_START_TIMEOUT=75
# After a start, how long to wait for a SocksPort to accept a connection, and
# how long an empty answer is cached (a tor still bootstrapping is picked up in
# seconds rather than after the full TOR_VERIFY_TTL).
TOR_BIND_WAIT=10
TOR_RETRY_AFTER=15
# Tor's own "am I Tor" answer, and how long a verdict is trusted. Nothing here
# calls a listener Tor on any other evidence.
TOR_CHECK_URL=https://check.torproject.org/api/ip
TOR_VERIFY_TIMEOUT=25
TOR_VERIFY_TTL=600
# Checks in flight through Tor (small: Tor's circuits are the bottleneck), how
# many requests one exit carries at once, and the ceiling for one request.
TOR_CONCURRENCY=8
TOR_PER_PROXY=2
TOR_TIMEOUT=20
# Tunnels one endpoint is asked to open at once -- optional, all have defaults.
# An endpoint is not dead because it was asked for more simultaneous tunnels
# than it accepts: silence at the ceiling is the same exception a dead host
# raises, so the pool paces the width instead of writing the endpoint off and
# only retires it after asking for one tunnel at a time and still getting
# nothing. These are the numbers behind that; the defaults are tuned, and only
# the floor and the trip count are worth moving by hand.
# Tunnels offered at one width before it is judged, the share of those that
# never opened which halves it, and the share at or under which the window
# counts as clean (above it, one tunnel comes off).
SNIPE_PROXY_PACE_WINDOW=
SNIPE_PROXY_PACE_RATE=
SNIPE_PROXY_PACE_RECOVER=
# Refusals in a row that cut the width immediately, clean windows in a row
# before it grows by one, the longest that pause grows to after a failed probe,
# and the floor it can be cut to.
SNIPE_PROXY_PACE_CONFIRM=
SNIPE_PROXY_PACE_GROW_AFTER=
SNIPE_PROXY_PACE_GROW_MAX=
SNIPE_PROXY_MIN_PARALLEL=
# PostgreSQL is required in production; local-only SQLite fallback:
ACCOUNT_DB_PATH=data/accounts.sqlite3
